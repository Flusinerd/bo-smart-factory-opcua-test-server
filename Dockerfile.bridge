# Build: docker build -f Dockerfile.bridge -t opcua-tcp-bridge .
FROM golang:1.22-bookworm AS build
WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY cmd ./cmd
COPY internal ./internal

RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /opcua-bridge ./cmd/opcua-bridge

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /opcua-bridge /opcua-bridge
EXPOSE 8080 9000
ENTRYPOINT ["/opcua-bridge"]
